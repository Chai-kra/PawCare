@{
    ViewBag.Title = "Contact";
}

<p class="lead">Questions, or ready to book? Reach us any of these ways.</p>

@* Replace the placeholder details below with the real studio information. *@
<div class="contact-grid">
    <div class="panel">
        <h2>Visit</h2>
        <p>12 Example Street<br>City, 00000</p>
    </div>
    <div class="panel">
        <h2>Call or write</h2>
        <p><a href="tel:+60123456789">+60 12-345 6789</a><br><a href="mailto:hello@@pawcare.example">hello@@pawcare.example</a></p>
    </div>
    <div class="panel">
        <h2>Opening hours</h2>
        <table class="hours">
            <tr><th scope="row">Mon - Fri</th><td>9:00 am - 6:00 pm</td></tr>
            <tr><th scope="row">Saturday</th><td>9:00 am - 4:00 pm</td></tr>
            <tr><th scope="row">Sunday</th><td>Closed</td></tr>
        </table>
    </div>
</div>
