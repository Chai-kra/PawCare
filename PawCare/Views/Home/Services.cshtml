@model IEnumerable<PawCare.Models.Service>

@{
    ViewBag.Title = "Services";
    ViewBag.HideTitle = true;
}

@*menu*@
<div class="page-head">
    <h1 class="page-title">Services</h1>
    <select id="category">
        <option value="">   - All Categories -   </option>
        <option>Baths and spa</option>
        <option>Cuts and styling</option>
        <option>Hygiene and health</option>
    </select>
</div>

<form class="service-search" method="get" role="search">
    @Html.TextBox("name", ViewData["ServiceName"] as string ?? "",
        new { type = "search", autofocus = "", data_trim = "", placeholder = "Search service..." })
    <button type="submit" class="btn-search">Search</button>
</form>

<p class="lead">Every package includes a gentle brush-out and a check of ears, nails and skin. Prices are a guide and may vary with coat length and size.</p>

<p>@Model.Count() record(s)</p>

@foreach (var s in Model)
{
    <section class="menu-group">
        <h2>@s.Category?.Name</h2>
        <div class="menu-item">
            <div>
                <h3>@s.Name</h3>
                <p>@s.Description</p>
            </div>
            <div class="menu-price">
                <strong>RM @s.Price</strong>
                <span>@s.Duration min</span>
                <form asp-controller="Cart" asp-action="Add" method="post" style="margin:8px 0 0;">
                    <input type="hidden" name="id" value="@s.Id" />
                    <input type="hidden" name="from" value="services" />
                    <button type="submit" class="btn btn-primary btn-book">Book</button>
                </form>
            </div>
        </div>
    </section>
}

<p class="note">Implement services in database or smn I guess, not sure</p>

