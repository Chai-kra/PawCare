@model ResetPasswordVM
@{
    ViewBag.Title = "Reset password";
    ViewBag.HideTitle = true;
}
@section head {
    <meta name="referrer" content="no-referrer">
}

<div class="login-container">
    <h2>Choose a New Password</h2>
    <p class="hint">Resetting the password for <strong>@Model.Email</strong>.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <form asp-action="ResetPassword" method="post">
        <input asp-for="Email" type="hidden" />
        <input asp-for="Token" type="hidden" />

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="login-controller" placeholder="Enter New Password" autocomplete="new-password" autofocus />
            <p class="hint">At least 8 characters, with a letter and a number.</p>
            <span asp-validation-for="Password" class="error-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="login-controller" placeholder="Confirm New Password" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="error-message"></span>
        </div>

        <button type="submit" class="btn-login">Set new password</button>
    </form>
</div>