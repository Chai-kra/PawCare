@model Customer
@{
    ViewBag.Title = "My account";
}

<p class="lead">Welcome back, <strong>@Model.Name</strong>.</p>

<div class="dashboard-grid">
    <section class="panel">
        <h2>Profile</h2>
        <p>@Model.Name<br>@Model.Email</p>
    </section>

    @* INSERT (pet managing): filter queries by User.CustomerId() *@
    <section class="panel panel-placeholder">
        <h2>My pets</h2>
        <p>Your pet profiles will appear here.</p>
    </section>

    <section class="panel">
        <h2>Appointments</h2>
        <p><a asp-controller="Booking" asp-action="Menu">View my appointments</a></p>
    </section>

    @* INSERT (loyalty points): award points server-side only *@
    <section class="panel panel-placeholder">
        <h2>Loyalty points</h2>
        <p>Points you earn from visits will appear here.</p>
    </section>
</div>
