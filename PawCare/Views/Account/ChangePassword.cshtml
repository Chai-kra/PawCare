@model ChangePasswordVM
@{
    ViewBag.Title = "Change password";
    ViewBag.HideTitle = true;
}

<div class="login-container">
    <h2>Change Password</h2>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <form asp-action="ChangePassword" method="post">
        <div class="form-group">
            <label asp-for="CurrentPassword"></label>
            <input asp-for="CurrentPassword" class="login-controller" autocomplete="current-password" autofocus />
            <span asp-validation-for="CurrentPassword" class="error-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="NewPassword"></label>
            <input asp-for="NewPassword" class="login-controller" autocomplete="new-password" />
            <p class="hint">At least 8 characters, with a letter and a number.</p>
            <span asp-validation-for="NewPassword" class="error-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" class="login-controller" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="error-message"></span>
        </div>

        <button type="submit" class="btn-login">Change password</button>
    </form>
</div>