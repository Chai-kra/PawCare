@using PawCare.Models
@model BookingVM
@{
    ViewBag.Title = "Book an appointment";
    ViewBag.HideTitle = true;
}
@section head {
    <link rel="stylesheet" href="/css/booking.css" asp-append-version="true">
}

<form asp-action="Create" method="post" id="bookingForm" class="bk-paper"
      data-slots-url="@Url.Action("Slots")"
      data-initial-slot="@Model.SlotTime">

    <h2 class="bk-title">Pet Grooming Appointment Form</h2>
    <p class="bk-intro">Booking as <strong>@User.Identity?.Name</strong>. We already have your contact details from your account.</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <div class="form-group">
        <label asp-for="PetName">Your buddy's name?</label>
        <input asp-for="PetName" class="bk-input" autocomplete="off" />
        <span asp-validation-for="PetName" class="error-message"></span>
    </div>

    <div class="form-group">
        <div class="bk-choices">
            <label class="bk-choice"><input asp-for="PetType" type="radio" value="Dog" id="PetType_Dog" /> It's a cute dog</label>
            <label class="bk-choice"><input asp-for="PetType" type="radio" value="Cat" id="PetType_Cat" /> It's a cute cat</label>
        </div>
        <span asp-validation-for="PetType" class="error-message"></span>
    </div>

    <div class="form-group">
        <label>Is your buddy a boy or a girl?</label>
        <div class="bk-choices">
            <label class="bk-choice"><input asp-for="PetGender" type="radio" value="Male" id="PetGender_Male" /> Male</label>
            <label class="bk-choice"><input asp-for="PetGender" type="radio" value="Female" id="PetGender_Female" /> Female</label>
        </div>
        <span asp-validation-for="PetGender" class="error-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="PetBreed">What breed is your buddy?</label>
        <input asp-for="PetBreed" class="bk-input" autocomplete="off" />
        <span asp-validation-for="PetBreed" class="error-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="Date">What day do you prefer for the appointment?</label>
        <input asp-for="Date" type="date" class="bk-input"
               min="@DateTime.Today.ToString("yyyy-MM-dd")"
               max="@DateTime.Today.AddDays(BookingRules.MaxAdvanceDays).ToString("yyyy-MM-dd")" />
        <span asp-validation-for="Date" class="error-message"></span>
    </div>

    <div class="form-group">
        <label>Which service do you choose this time?</label>
        <div class="bk-services">
            @foreach (var p in Model.Packages)
            {
                var pkgId = "pkg_" + p.Id;
                <label class="bk-service" for="@pkgId">
                    <input type="radio" class="package-radio" name="ServicePackageId" id="@pkgId" value="@p.Id"
                           data-duration="@p.TimeAmount" data-price="@p.Price.ToString("0.00")"
                           checked="@(Model.ServicePackageId == p.Id)" />
                    <span>
                        <span class="bk-service-name">@p.ServiceType</span>
                        <span class="bk-service-meta">RM @p.Price.ToString("0.00") &middot; @p.TimeAmount min</span>
                    </span>
                </label>
            }
        </div>
        <span asp-validation-for="ServicePackageId" class="error-message"></span>
        <span id="packageError" class="error-message"></span>
        <p class="bk-total">Total: <strong id="sumPrice">RM 0.00</strong> &middot; <span id="sumDuration">0 min</span></p>
    </div>

    <div class="form-group">
        <label>Which time suits you?</label>
        <div id="slotBox">
            <p class="hint">Select a date and a service to see available times.</p>
        </div>
        <input type="hidden" asp-for="SlotTime" />
        <span asp-validation-for="SlotTime" class="error-message"></span>
        <span id="slotError" class="error-message"></span>
    </div>

    <div class="form-group">
        <label asp-for="StaffId">Do you prefer a particular groomer? (optional)</label>
        <select asp-for="StaffId" asp-items="Model.Staff" class="bk-input">
            <option value="">Any available staff</option>
        </select>
    </div>

    <div class="form-group">
        <label asp-for="Notes">Any additional description we should aware of?:</label>
        <textarea asp-for="Notes" class="bk-input" rows="4"></textarea>
        <span asp-validation-for="Notes" class="error-message"></span>
    </div>

    <div class="bk-actions">
        <button type="submit" class="btn btn-primary">Book appointment</button>
        <a asp-action="Menu" class="btn btn-outline">Back</a>
    </div>
</form>

@section foot {
    <script src="/js/booking.js" asp-append-version="true"></script>
}