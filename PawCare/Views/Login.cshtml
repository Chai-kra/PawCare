@{
    ViewBag.Title = "Login";
}

<div class="login-container">
    <h2>Login</h2>

    <div asp-validation-summary="ModelOnly" class="alert alert-error"></div>

    <form asp-action="Login" method="POST">
        <div class="form-group">
            <label asp-for="Email"></label>
            <input asp-for="Email" class="login-controller" placeholder="Enter Email"/>
            <span asp-validation-for="Email" class="error-message"></span>
        </div>

        <div class="form-group">
            <label asp-for="Password"></label>
            <input asp-for="Password" class="login-controller" placeholder="Enter Password" />
            <span asp-validation-for="Password" class="error-message"></span>
        </div>

        <div class="form-group form-check">
            <input asp-for="RememberMe" type="checkbox" />
            <label asp-for="RememberMe">Remember me</label>
        </div>

        <div class="form-group">
            <div class="g-recaptcha" data-sitekey="xxx"></div>
        </div>

        <button type="submit" class="btn-login">Login</button>
    </form>

    <div class="login-links">
        <a asp-action="Register">Create an account</a>
        <a asp-action="ResendVerification">Resend verification email</a>
    </div>
    
</div>

@section Script{

}