@model IEnumerable<PawCare.ViewModels.CartItemVM>
@{
    ViewBag.Title = "Cart";
    var total = ViewData["Total"] is decimal t ? t : 0m;
}

@section head {
    <link rel="stylesheet" href="/css/cart.css" asp-append-version="true">
}

<p>@Model.Count() item(s)</p>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
    <p>
        <a asp-controller="Home" asp-action="Products">Browse products</a> &middot;
        <a asp-controller="Home" asp-action="Services">Browse services</a>
    </p>
}
else
{
    <table class="cart-table">
        <thead>
            <tr>
                <th>Item</th>
                <th>Type</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in Model)
            {
                <tr>
                    <td>@it.Name</td>
                    <td>@it.Type</td>
                    <td>RM @it.Price.ToString("0.00")</td>
                    <td>@it.Qty</td>
                    <td>RM @((it.Price * it.Qty).ToString("0.00"))</td>
                    <td>
                        <form asp-action="Update" method="post" class="cart-qty">
                            <input type="hidden" name="id" value="@it.Id" />

                            <button type="submit" name="op" value="minus" class="cart-qty-btn" aria-label="Decrease"> &minus; </button>

                            @if (it.Type == "Product")
                            {
                                <button type="submit" name="op" value="plus" class="cart-qty-btn" aria-label="Increase"> + </button>
                            }

                            <button type="submit" name="op" value="remove" class="btn btn-outline"> Remove </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="cart-total">Total: RM @total.ToString("0.00")</p>

    <div class="cart-actions">
        <form asp-action="Clear" method="post">
            <button type="submit" class="btn btn-outline">Clear cart</button>
        </form>
        <form asp-action="Checkout" method="post">
            <button type="submit" class="btn btn-primary">Proceed to checkout</button>
        </form>
    </div>
}