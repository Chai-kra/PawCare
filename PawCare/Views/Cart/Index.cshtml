@model IEnumerable<PawCare.ViewModels.CartItemVM>
@{
    ViewBag.Title = "Cart";
}

<p>@Model.Count() item(s)</p>

@if (!Model.Any())
{
    <p>Your cart is empty.</p>
    <p><a asp-controller="Home" asp-action="Products">Browse products</a></p>
}
else
{
    <table style="width:100%; border-collapse:collapse; margin-bottom:16px;">
        <thead>
            <tr style="text-align:left; border-bottom:1px solid #ddd;">
                <th style="padding:8px 0;">Item</th>
                <th>Type</th>
                <th>Price</th>
                <th>Qty</th>
                <th>Subtotal</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var it in Model)
            {
                <tr style="border-bottom:1px solid #eee;">
                    <td style="padding:8px 0;">@it.Name</td>
                    <td>@it.Type</td>
                    <td>RM @it.Price</td>
                    <td>@it.Qty</td>
                    <td>RM @(it.Price * it.Qty)</td>
                    <td>
                        <form asp-action="Remove" method="post">
                            <input type="hidden" name="id" value="@it.Id" />
                            <button type="submit" class="btn btn-outline">Remove</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p><strong>Total: RM @ViewData["Total"]</strong></p>

    <form asp-action="Clear" method="post">
        <button type="submit" class="btn btn-outline">Clear cart</button>
    </form>
    <form asp-action="Checkout" method="post">
        <button type="submit" class="btn btn-primary">Proceed to Checkout</button>
    </form>

}